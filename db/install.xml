<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/assign/submission/reflectivejournal/db" VERSION="20261121" COMMENT="XMLDB file for the Reflective journal submission plugin"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="assignsubmission_rjentry" COMMENT="Entries in a Reflective journal">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="assignment" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The assignment this Entry belongs to"/>
        <FIELD NAME="submission" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The submission (attempt) this Entry belongs to"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The student who wrote the Entry"/>
        <FIELD NAME="entrynumber" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Position of the Entry in the Journal, starting at 1"/>
        <FIELD NAME="model" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="none" SEQUENCE="false" COMMENT="Reflective Model chosen for the Entry"/>
        <FIELD NAME="entrytext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="entryformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time of the last save"/>
        <FIELD NAME="timelocked" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Time the Entry was Locked and the Tutor notified; null while not yet processed"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="assignment" TYPE="foreign" FIELDS="assignment" REFTABLE="assign" REFFIELDS="id"/>
        <KEY NAME="submission" TYPE="foreign" FIELDS="submission" REFTABLE="assign_submission" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="submissionentry" UNIQUE="true" FIELDS="submission, entrynumber"/>
        <INDEX NAME="timelocked" UNIQUE="false" FIELDS="timelocked"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="assignsubmission_rjcomment" COMMENT="Tutor Comments on Reflective journal Entries">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="entry" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The Entry this Comment is about"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The tutor who wrote the Comment; 0 once anonymised"/>
        <FIELD NAME="commenttext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="commentformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time of the last save"/>
        <FIELD NAME="timelocked" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Time the Comment was Locked and the student notified; null while not yet processed"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="entry" TYPE="foreign-unique" FIELDS="entry" REFTABLE="assignsubmission_rjentry" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="timelocked" UNIQUE="false" FIELDS="timelocked"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
